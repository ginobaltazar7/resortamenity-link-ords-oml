{
  "$schema": "https://json-schema.org",
  "title": "ResortAmenityTransaction",
  "type": "object",
  "required": [
    "transaction_id",
    "opera_guest_id",
    "amenity_type",
    "booking_timestamp",
    "amount_spent_jpy"
  ],
  "properties": {
    "transaction_id": { "type": "string" },
    "opera_guest_id": { "type": "string" },
    "amenity_type": { "type": "string", "enum": ["SPA_TREATMENT", "SKI_RENTAL", "LIFT_TICKET", "PRIVATE_GUIDE"] },
    "booking_timestamp": { "type": "string", "format": "date-time" },
    "amount_spent_jpy": { "type": "integer", "minimum": 0 },
    "service_details": {
      "type": "object",
      "required": ["item_name", "duration_minutes"],
      "properties": {
        "item_name": { "type": "string" },
        "duration_minutes": { "type": "integer" }
      }
    }
  }
}
